server {
    listen 80;
    server_name pepscheckoutportal.com www.pepscheckoutportal.com
                swiftremit.ca www.swiftremit.ca
                crypto.pepscheckoutportal.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pepscheckoutportal.com www.pepscheckoutportal.com swiftremit.ca www.swiftremit.ca;

    ssl_certificate /etc/ssl/certs/pepscheckout.crt;
    ssl_certificate_key /etc/ssl/private/pepscheckout.key;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name crypto.pepscheckoutportal.com;

    ssl_certificate /etc/ssl/certs/pepscheckout.crt;
    ssl_certificate_key /etc/ssl/private/pepscheckout.key;

    location / {
        proxy_pass http://127.0.0.1:23000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
