server {
    listen 80;
    server_name pepscheckoutportal.com www.pepscheckoutportal.com
                swiftremit.ca www.swiftremit.ca
                crypto.pepscheckoutportal.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pepscheckoutportal.com www.pepscheckoutportal.com swiftremit.ca www.swiftremit.ca;

    ssl_certificate /etc/ssl/certs/pepscheckout.crt;
    ssl_certificate_key /etc/ssl/private/pepscheckout.key;

    # Serve static assets directly from disk instead of proxying every
    # request through the Python process. `no-cache, must-revalidate`
    # (not a blind max-age) is deliberate: nginx already sends Last-Modified/
    # ETag for static files and honors conditional GETs automatically, so
    # this tells the browser "always ask if it's still fresh" — a deploy
    # shows up on the very next load (cheap 304 if unchanged, fresh bytes
    # if changed) instead of possibly being hidden behind a stale time-based
    # cache for however long max-age was set to.
    location /static/ {
        alias /srv/shared/checkout-server/static/;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name crypto.pepscheckoutportal.com;

    ssl_certificate /etc/ssl/certs/pepscheckout.crt;
    ssl_certificate_key /etc/ssl/private/pepscheckout.key;

    location / {
        proxy_pass http://127.0.0.1:23000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
