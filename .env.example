# ========================
# DATABASE
# ========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=checkout_db
DB_USER=checkout_user
DB_PASSWORD=your_strong_password_here

# ========================
# APP
# ========================
SECRET_KEY=generate_a_random_64char_secret_here
ENVIRONMENT=production          # production | development
BASE_URL=https://checkout.yourdomain.com

# ========================
# REDIS (Celery broker)
# ========================
REDIS_URL=redis://127.0.0.1:6379/0

# ========================
# HELCIM (Credit Cards)
# ========================
# Per-brand keys go in the brands table.
# This is the fallback/default key if brand has none set.
HELCIM_API_TOKEN=your_helcim_api_token
HELCIM_API_URL=https://api.helcim.com/v2

# ========================
# BTCPAY SERVER
# ========================
BTCPAY_URL=https://btcpay.yourdomain.com        # Your BTCPay instance URL
BTCPAY_API_KEY=your_btcpay_api_key              # Account API key from BTCPay
BTCPAY_STORE_ID=your_btcpay_store_id            # Store ID in BTCPay
BTCPAY_WEBHOOK_SECRET=generate_random_secret    # Set in BTCPay webhook config

# ========================
# GMAIL (Interac e-Transfer watcher)
# ========================
GMAIL_CREDENTIALS_FILE=/home/ubuntu/checkout-server/gmail_credentials.json
GMAIL_TOKEN_FILE=/home/ubuntu/checkout-server/gmail_token.json
GMAIL_WATCH_EMAIL=CheckoutCaster@proton.me      # The Interac deposit email (manual mode for now)

# ========================
# INTERAC
# ========================
# Default interac email shown to customers (override per brand in DB)
INTERAC_DEFAULT_EMAIL=CheckoutCaster@proton.me

# ========================
# POLLING INTERVALS (seconds)
# ========================
INTERAC_POLL_INTERVAL=300      # 5 minutes
ORDER_EXPIRY_HOURS=24          # Auto-expire unpaid orders after X hours

# ========================
# WPAY CHANNELS (hosted-redirect card processor)
# ========================
WPAY_ENABLED=false
WPAY_UID=your_wpay_merchant_uid
WPAY_USER_TOKEN=your_wpay_user_token
# ""    → no stores see the option
# "*"   → all stores
# "..." → comma-separated allowlist of store domains
WPAY_STORES=

# ========================
# WPAY 2D (via the same WordPress + WooCommerce site as ONRAMP_WP_*)
# ========================
# Reuses ONRAMP_WP_URL / ONRAMP_WP_CONSUMER_KEY / ONRAMP_WP_CONSUMER_SECRET
# (or ONRAMP_WP_USERNAME / ONRAMP_WP_APP_PASSWORD) above — same site, same
# credentials. Separate option from WPAY_ENABLED (the HPP flow); both can be
# enabled at once.
WPAY_WP_ENABLED=false
WPAY_WP_GATEWAY_ID=wpay_2d
WPAY_WP_PRODUCT_ID=
WPAY_WP_WEBHOOK_SECRET=
WPAY_WP_STORES=
